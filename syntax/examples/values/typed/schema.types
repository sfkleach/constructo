// The types that the examples in this directory are checked against.
enum Shape =
  Circle { radius: Float },
  Box { width: Float, height: Float },
  Dot,
  Pair(Nat, Int);
enum List<T> = Nil, Cons { head: T, tail: List<T> };
enum Config = Config { name: String, owner: Option<String>, limits: { cpu: Nat, mem: Nat }, tags: [String] };
const Unit: Shape = Circle { radius: 1.0 };
const max_width: Float = 100.0;
const default_radius = 2.5;
const no_tags = [];
enum Image = Image(String, String, hOffset: Nat, vOffset: Nat, alignment: String);
