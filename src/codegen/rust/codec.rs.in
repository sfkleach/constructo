    fn read_value(
        &self,
        value: &::constructo_runtime::ast::Value,
        depth: u32,
    ) -> ::std::result::Result<::std::string::String, ::constructo_runtime::codec::Error> {
        self.read_with(value, depth, |value, _| ::constructo_runtime::codec::read_string(value))
    }
}

impl self::WriteValue<::std::string::String> for self::Codec {
    fn write_value(
        &self,
        value: &::std::string::String,
        depth: u32,
    ) -> ::std::result::Result<::constructo_runtime::ast::Value, ::constructo_runtime::codec::Error> {
