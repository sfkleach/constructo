impl self::DefaultValue<::std::string::String> for self::Codec {
    fn default_value(
        &self,
        budget: &mut usize,
    ) -> ::std::result::Result<::std::string::String, ::constructo_runtime::codec::NoDefault> {
        ::constructo_runtime::codec::spend(budget)?;
        ::std::result::Result::Ok(::std::string::String::new())
    }
