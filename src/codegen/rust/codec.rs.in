impl<T> self::ReadValue<::std::vec::Vec<T>> for self::Codec
where
    self::Codec: self::ReadValue<T>,
{
    fn read_value(
        &self,
        value: &::constructo_runtime::ast::Value,
        depth: u32,
    ) -> ::std::result::Result<::std::vec::Vec<T>, ::constructo_runtime::codec::Error> {
        // The type is given, as it is to each helper in a generic impl, since Rust would otherwise take the type of
        // the bound on `T` for it.
        self.read_with::<::std::vec::Vec<T>>(value, depth, |value, depth| match &value.kind {
            ::constructo_runtime::ast::ValueKind::Array(items) => self.items::<T>(items, depth),
            _ => ::std::result::Result::Err(self.mismatch("an array", value)),
        })
    }
}

impl<T> self::WriteValue<::std::vec::Vec<T>> for self::Codec
where
    self::Codec: self::WriteValue<T>,
{
    fn write_value(
        &self,
        value: &::std::vec::Vec<T>,
        depth: u32,
    ) -> ::std::result::Result<::constructo_runtime::ast::Value, ::constructo_runtime::codec::Error> {
        let depth = self.enter_write(depth)?;
        ::std::result::Result::Ok(::constructo_runtime::codec::array(self.put_items::<T>(value, depth)?))
    }
}

impl<T> self::DefaultValue<::std::vec::Vec<T>> for self::Codec {
    fn default_value(
        &self,
        budget: &mut usize,
    ) -> ::std::result::Result<::std::vec::Vec<T>, ::constructo_runtime::codec::NoDefault> {
        ::constructo_runtime::codec::spend(budget)?;
        ::std::result::Result::Ok(::std::vec::Vec::new())
    }
}

// A `Box` is not seen in the text: it is read and written as what it holds, at the same depth.

impl<T> self::ReadValue<::std::boxed::Box<T>> for self::Codec
where
    self::Codec: self::ReadValue<T>,
{
    fn read_value(
        &self,
        value: &::constructo_runtime::ast::Value,
        depth: u32,
    ) -> ::std::result::Result<::std::boxed::Box<T>, ::constructo_runtime::codec::Error> {
        <Self as self::ReadValue<T>>::read_value(self, value, depth).map(::std::boxed::Box::new)
    }
}

impl<T> self::WriteValue<::std::boxed::Box<T>> for self::Codec
where
    self::Codec: self::WriteValue<T>,
{
    fn write_value(
        &self,
        value: &::std::boxed::Box<T>,
        depth: u32,
    ) -> ::std::result::Result<::constructo_runtime::ast::Value, ::constructo_runtime::codec::Error> {
        <Self as self::WriteValue<T>>::write_value(self, value, depth)
    }
}

impl<T> self::DefaultValue<::std::boxed::Box<T>> for self::Codec
where
    self::Codec: self::DefaultValue<T>,
{
    fn default_value(
        &self,
        budget: &mut usize,
    ) -> ::std::result::Result<::std::boxed::Box<T>, ::constructo_runtime::codec::NoDefault> {
        <Self as self::DefaultValue<T>>::default_value(self, budget).map(::std::boxed::Box::new)
    }
}
